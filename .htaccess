# =========================================================
# Blasfen Lubrificantes — configuração do servidor (Apache / LiteSpeed)
# Vai na pasta raiz do site, junto com o index.html.
# =========================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTPS obrigatório e domínio com www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.blasfenlubrificantes.com.br%{REQUEST_URI} [L,R=301]

  # Pastas e arquivos de trabalho nunca devem ser servidos, mesmo se forem enviados por engano
  RewriteRule ^(lixo|docs|tools|dist)(/.*)?$ - [R=404,L]
  RewriteRule ^Itens\ faltantes - [R=404,L]

  # 2) URLs amigáveis: /produtos/metalworking.html -> /produtos/metalworking
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # Blog técnico retirado do site: endereços antigos levam para a página inicial
  RewriteRule ^blog(/.*)?$ / [L,R=301]

  # Linha Eco Spray retirada do site: endereço antigo leva para a página de produtos
  RewriteRule ^produtos/eco-spray-desengripante(\.html)?/?$ /produtos/ [L,R=301]

  # Linha Florestal retirada (não consta nos folders): endereço antigo leva para a página de produtos
  RewriteRule ^produtos/florestal(\.html)?/?$ /produtos/ [L,R=301]

  # 3) Serve o arquivo .html correspondente sem mostrar a extensão
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------- Segurança ----------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By
  Header unset X-Powered-By
  # Política de conteúdo: só carrega scripts do próprio site e do Google Analytics,
  # fontes do Google Fonts, mapa do Google Maps e envio do formulário pelo FormSubmit.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://www.google.com https://maps.google.com; form-action 'self' https://formsubmit.co; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Bloqueia acesso a arquivos ocultos e de configuração
<FilesMatch "^\.|\.(md|py|json|log|bak|sql|xlsx|pptx|docx|zip|rar|env|ini|sh|bat|ps1)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
<Files "site.webmanifest">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>

# ---------- Compressão ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# ---------- Cache no navegador ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS e JS levam ?v=... no link (gerado pelo build), então podem ficar em cache por 1 ano
  <FilesMatch "\.(css|js|webp|avif|png|jpe?g|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddType image/webp .webp
AddType image/avif .avif
AddType application/manifest+json .webmanifest
